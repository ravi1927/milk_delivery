{
  "expo": {
    "name": "Dhaara A2 Milk",
    "slug": "milk-delivery-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "milkdelivery",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.demo.milkdelivery",
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1578C8"
      }
    },
    "ios": {
      "bundleIdentifier": "com.demo.milkdelivery",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dhaara A2 Milk uses your location when you pin a customer for delivery."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da00864b-07be-4974-aea8-15089966187e"
      }
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFFFFF"
  }
}
